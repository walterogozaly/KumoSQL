[
 {
  "id": "databricks-distinct-on-a-key",
  "source": "https://docs.databricks.com/gcp/en/sql/user/queries/query-optimization-constraints",
  "source_quote": "Because the c_customer_sk column is a verified PRIMARY KEY constraint, all values in the column are unique.",
  "columns": {"customer": ["c_customer_sk"]},
  "left": "SELECT DISTINCT c_customer_sk FROM customer",
  "right": "SELECT c_customer_sk FROM customer",
  "conditions": ["(c_customer_sk) is unique in customer", "customer.c_customer_sk is NOT NULL"],
  "breaks": [{"customer": [[1], [1], [null]]}, {"customer": [[null], [null]]}],
  "holds": [{"customer": []}, {"customer": [[1], [2]]}]
 },
 {
  "id": "databricks-unused-left-join",
  "source": "https://docs.databricks.com/gcp/en/sql/user/queries/query-optimization-constraints",
  "source_quote": "Because the operation is an outer join, all records from store_sales are preserved.",
  "columns": {"store_sales": ["ss_quantity", "customer_sk"], "customer": ["c_customer_sk"]},
  "left": "SELECT SUM(ss_quantity) AS s FROM store_sales ss LEFT JOIN customer c ON ss.customer_sk = c.c_customer_sk",
  "right": "SELECT SUM(ss_quantity) AS s FROM store_sales ss",
  "conditions": ["(c_customer_sk) is unique in customer"],
  "breaks": [{"store_sales": [[3, 1], [4, 2]], "customer": [[1], [1]]}],
  "holds": [{"store_sales": [[3, 1], [4, null], [5, 9]], "customer": [[1], [null], [null]]}, {"store_sales": [], "customer": []}]
 }
]
