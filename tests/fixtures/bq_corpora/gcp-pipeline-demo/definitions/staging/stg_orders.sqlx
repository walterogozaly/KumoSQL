config {
  type: "incremental",
  schema: dataform.projectConfig.vars.stagingDataset,
  name: "stg_orders",
  description: "Deduplicated order events with a rolling window for late arrivals.",
  tags: ["daily"],
  protected: true,
  uniqueKey: ["event_id"],
  assertions: {
    uniqueKey: ["event_id"],
    nonNull: ["event_id", "order_id", "customer_id", "event_type", "event_ts", "ingested_at"],
    rowConditions: [
      "event_type IN ('CREATED', 'PAID', 'CANCELLED')",
      "amount IS NULL OR amount >= 0"
    ]
  },
  bigquery: {
    partitionBy: "DATE(event_ts)",
    clusterBy: ["order_id", "customer_id"],
    updatePartitionFilter: `event_ts >= TIMESTAMP_SUB(CURRENT_TIMESTAMP(), INTERVAL ${dataform.projectConfig.vars.targetPartitionDays} DAY)`,
    labels: {
      domain: "orders",
      layer: "staging"
    }
  },
  columns: {
    event_id: "Source event id used as the idempotency key.",
    order_id: "Business order identifier.",
    customer_id: "Customer identifier.",
    event_type: "Order lifecycle event.",
    event_ts: "Business event timestamp.",
    amount: "Event amount in the source currency.",
    currency: "ISO-like currency code supplied by the source.",
    ingested_at: "Timestamp when the event reached BigQuery."
  }
}

WITH ranked_events AS (
  SELECT
    event_id,
    order_id,
    customer_id,
    UPPER(event_type) AS event_type,
    event_ts,
    SAFE_CAST(amount AS NUMERIC) AS amount,
    UPPER(currency) AS currency,
    ingested_at,
    ROW_NUMBER() OVER (
      PARTITION BY event_id
      ORDER BY ingested_at DESC, event_ts DESC
    ) AS row_number
  FROM ${ref("raw_orders")}
  ${when(
    incremental(),
    `WHERE ingested_at >= TIMESTAMP_SUB(CURRENT_TIMESTAMP(), INTERVAL ${dataform.projectConfig.vars.lateArrivalDays} DAY)`
  )}
)

SELECT
  event_id,
  order_id,
  customer_id,
  event_type,
  event_ts,
  amount,
  currency,
  ingested_at
FROM ranked_events
WHERE row_number = 1
