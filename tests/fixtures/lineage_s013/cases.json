  "src": {
   "k": "INT64",
   "v": "INT64",
   "w": "INT64",
   "g": "STRING",
   "flag": "BOOL",
   "arr": "ARRAY<INT64>",
   "rec": "STRUCT<a INT64, b INT64>"
  },
  "other": {
   "k": "INT64",
   "v": "INT64",
   "w": "INT64"
  }
 },
 "cases": [
